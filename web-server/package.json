{
  "name": "shield-singa-web-server",
  "version": "1.0.0",
  "private": true,
  "description": "Shield Singa Web Server - API + Playwright Crawler",
  "scripts": {
    "dev": "node server.js",
    "build": "node -e \"console.log('web-server has no standalone build step')\"",
    "start": "node server.js",
    "lint": "next lint",
    "server": "node server.js",
    "dev:server": "node server.js",
    "dev:full": "concurrently \"pnpm --dir ../web dev\" \"wait-on http://localhost:8080 && node server.js\""
  },
  "dependencies": {
    "axios": "^1.6.8",
    "class-transformer": "^0.5.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.6",
    "electron-log": "^5.2.4",
    "express": "^5.1.0",
    "mysql2": "^3.9.0",
    "playwright": "^1.49.1",
    "playwright-core": "^1.49.1",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/d3-scale-chromatic": "^3.0.3",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sortablejs": "^1.15.8",
    "autoprefixer": "^10.0.1",
    "concurrently": "^8.2.2",
    "electron": "^41.0.3",
    "eslint": "^8",
    "eslint-config-next": "14.1.3",
    "next-plugin-antd-less": "^1.8.0",
    "postcss": "^8",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  }
}
